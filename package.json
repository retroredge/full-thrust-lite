{
  "name": "full-thrust-light",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run lint && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src tests vite.config.ts && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
